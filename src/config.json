  "MACROS": {
    "RM_IHPSG13_1P_256x48_c2_bm_bist": {
      "gds": [
        "dir::RM_IHPSG13_1P_256x48_c2_bm_bist_fixed.gds"
      ],
      "lef": [
        "pdk_dir::libs.ref/sg13g2_sram/lef/RM_IHPSG13_1P_256x48_c2_bm_bist.lef"
      ],
      "nl": [
        "dir::sram_256x48_bb.v"
      ],
      "lib": {
        "*fast*": [
          "pdk_dir::libs.ref/sg13g2_sram/lib/RM_IHPSG13_1P_256x48_c2_bm_bist_fast_1p32V_m55C.lib"
        ],
        "*typ*": [
          "pdk_dir::libs.ref/sg13g2_sram/lib/RM_IHPSG13_1P_256x48_c2_bm_bist_typ_1p20V_25C.lib"
        ],
        "*slow*": [
          "pdk_dir::libs.ref/sg13g2_sram/lib/RM_IHPSG13_1P_256x48_c2_bm_bist_slow_1p08V_125C.lib"
        ]
      },

      "instances": {
        "eng[0].u_imem.u_sram": {
          "location": [30.24, 30.24],
          "orientation": "N"
        },
        "eng[1].u_imem.u_sram": {
          "location": [662.56, 30.24],
